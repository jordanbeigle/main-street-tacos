<script>
// ── EDIT MODE ──
let editMode = false;
const editables = document.querySelectorAll('[contenteditable]');

function toggleEditMode() {
  editMode = !editMode;
  const btn = document.getElementById('edit-toggle');
  const saveBtn = document.getElementById('save-btn');

  editables.forEach(el => {
    el.contentEditable = editMode ? 'true' : 'false';
  });

  document.body.classList.toggle('edit-mode', editMode);
  btn.textContent = editMode ? '✅ Done Editing' : '✏️ Edit Website';
  btn.classList.toggle('active', editMode);
  saveBtn.style.display = editMode ? 'block' : 'none';
}

function saveChanges() {
  // Snapshot the full page HTML and download it
  const clone = document.documentElement.cloneNode(true);
  // Turn off edit mode in the saved copy
  clone.querySelectorAll('[contenteditable]').forEach(el => el.removeAttribute('contenteditable'));
  clone.querySelector('#edit-toolbar').remove();
  clone.querySelector('.edit-hint').remove();
  // Remove edit-mode styles from body class
  clone.querySelector('body').classList.remove('edit-mode');

  const html = '<!DOCTYPE html>\n' + clone.outerHTML;
  const blob = new Blob([html], { type: 'text/html' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'main_street_tacos_updated.html';
  a.click();
  URL.revokeObjectURL(a.href);

  // Visual feedback
  const btn = document.getElementById('save-btn');
  btn.textContent = '✓ Saved!';
  btn.style.background = '#2ecc71';
  setTimeout(() => {
    btn.textContent = '💾 Save Changes';
    btn.style.background = '';
  }, 2000);
}



// ── SCROLL REVEAL ──
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.style.opacity = '1';
      e.target.style.transform = 'translateY(0)';
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.card, .addon, .gallery-item, .about-grid, .contact-grid').forEach(el => {
  el.style.opacity = '0';
  el.style.transform = 'translateY(20px)';
  el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
  observer.observe(el);
});
</script>

